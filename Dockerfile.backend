FROM node:22-bookworm-slim

WORKDIR /app/myshop-backend

# Copy dependency files
COPY myshop-backend/package*.json ./

# Install production dependencies
RUN npm ci --omit=dev

# Copy backend source
COPY myshop-backend/ ./

# Copy frontend product data required by backend
COPY myshop-premium/src/data.js /app/myshop-premium/src/data.js

ENV NODE_ENV=production

EXPOSE 4000

CMD ["npm", "start"]
